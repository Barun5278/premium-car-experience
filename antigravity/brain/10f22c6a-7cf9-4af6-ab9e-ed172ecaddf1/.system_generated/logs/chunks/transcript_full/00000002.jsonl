   \"crimson-glow\": \"0 0 20px rgba(255, 42, 84, 0.25)\",\n        \"gold-glow\": \"0 0 20px rgba(212, 175, 55, 0.22)\",\n        \"glass-elevated\": \"0 8px 32px 0 rgba(0, 0, 0, 0.45)\",\n      },\n      backdropBlur: {\n        xs: \"2px\",\n        subtle: \"12px\",\n        glass: \"20px\",\n      },\n    },\n  },\n  plugins: [],\n};\n\nexport default config;\n","Description":"Update tailwind.config.ts with full design system tokens","Overwrite":true,"TargetFile":"C:\\Users\\chauh\\.gemini\\antigravity\\scratch\\automind-ai\\frontend\\tailwind.config.ts","toolAction":"Updating tailwind config","toolSummary":"Update frontend/tailwind.config.ts"}}]}
