obals.css with standard Tailwind directives and tokens","Overwrite":true,"TargetFile":"C:\\Users\\chauh\\.gemini\\antigravity\\scratch\\automind-ai\\frontend\\app\\globals.css","toolAction":"Updating globals.css","toolSummary":"Update frontend/app/globals.css"}}]}
