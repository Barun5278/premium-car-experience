viewports (reserved for Phase 2)\n│   │   ├── layout/                # Shell & navigation components\n│   │   └── ai/                    # AI conversational components\n│   ├── lib/\n│   │   ├── api/client.ts          # Typed client (api.cars, api.ml, api.ai, api.health)\n│   │   ├── constants/             # Automotive theme tokens & navigation hierarchy\n│   │   └── utils.ts               # Formatting (currency, mileage, HP, 0-60s) & cn()\n│   ├── types/\n│   │   ├── car.ts                 # Full car model, specs, media, & filter types\n│   │   ├── ml.ts                  # Valuation request/response DTOs & feature impacts\n│   │   ├── ai.ts                  # Gemini assistant chat & recommendation types\n│   │   └── index.ts               # Shared API envelope & paginated result interfaces\n│   ├── package.json               # Next.js, React, Tailwind, Lucide, Framer Motion, Three.js\n│   ├── tailwind.config.ts         # Automotive color extensions (cyan, crimson, surface)\n│   └── tsconfig.json              # Strict TypeScript config with @/* path aliases\n│\n├── backend/                       # FastAPI REST API (Python 3.12, Pydantic v2)\n│   ├── main.py                    # App entrypoint with CORS & versioned router mounting\n│   ├── requirements.txt           # FastAPI, Uvicorn, Pydantic, Supabase, Google GenAI\n│   ├── .env.example               # Environment template (Gemini, Supabase, DB URL)\n│   └── app/\n│       ├── core/config.py         # Type-safe settings via pydantic-settings\n│       ├── db/session.py          # Supabase client & DB connection management\n│       ├── schemas/               # Pydantic DTOs matching TypeScript models\n│       ├── services/              # Decoupled business logic (Car, ML Valuation, Gemini AI)\n│       └── api/v1/                # REST endpoints (/health, /cars, /ml, /ai)\n│\n└── ml/                            # Machine Learning Subsystem (Scikit-Learn, XGBoost)\n    ├── README.md                  # Model architecture