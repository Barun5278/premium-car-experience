       return fetcher<PaginatedResult<Car>>(`/cars?${query.toString()}`);\n49:     },\n50:     getById: (id: string) => fetcher<Car>(`/cars/${id}`),\n51:     getFeatured: () => fetcher<Car[]>(`/cars/featured`),\n52:     compare: (carIds: string[]) =>\n53:       fetcher<{ cars: Car[]; comparisonMatrix: Record<string, unknown> }>(\n54:         `/cars/compare?ids=${carIds.join(\",\")}`\n55:       ),\n56:   },\n57: \n58:   // ML Valuation\n59:   ml: {\n60:     predictPrice: (payload: ValuationRequest) =>\n61:       fetcher<ValuationResponse>(\"/ml/predict-price\", {\n62:         method: \"POST\",\n63:         body: JSON.stringify(payload),\n64:       }),\n65:   },\n66: \n67:   // Gemini AI Assistant\n68:   ai: {\n69:     chat: (payload: AssistantChatRequest) =>\n70:       fetcher<AssistantChatResponse>(\"/ai/chat\", {\n71:         method: \"POST\",\n72:         body: JSON.stringify(payload),\n73:       }),\n74:     recommend: (payload: RecommendationRequest) =>\n75:       fetcher<RecommendationResponse>(\"/ai/recommend\", {\n76:         method: \"POST\",\n77:         body: JSON.stringify(payload),\n78:       }),\n79:   },\n80: \n81:   // Health\n82:   health: () => fetcher<{ status: string; version: string; services: Record<string, string> }>(\"/health\"),\n83: };\n84: \nThe above content shows the entire, complete file contents of the requested file.\n"}
